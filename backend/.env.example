PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/intelligent_job_aggregation
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development
CRON_ENABLED=true
CRON_EXPRESSION=0 */6 * * *
CRON_SOURCES=linkedin,naukri,apna,indeed,remotive,remoteok
# Job-alert emails every 5 minutes
ALERT_CRON_EXPRESSION=*/5 * * * *

# --- Job alert emails (pick ONE free provider) ---
# Recommended: Resend — https://resend.com/api-keys  (3,000/month free)
RESEND_API_KEY=
EMAIL_FROM=Intelligent Job Aggregation <onboarding@resend.dev>
RESEND_ACCOUNT_EMAIL=you@gmail.com

# Alternative: Brevo — https://app.brevo.com/settings/keys/api  (300/day free)
# BREVO_API_KEY=

# Alternative: SendGrid — https://app.sendgrid.com/settings/api_keys  (100/day free)
# SENDGRID_API_KEY=

# Alternative: SMTP (MailerSend / Brevo SMTP / Gmail App Password)
# SMTP_HOST=smtp.mailersend.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Intelligent Job Aggregation <you@yourdomain.com>

# Google Gemini (resume parse + match insights)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
